# Alpaca (Paper Trading)
# Get keys from https://app.alpaca.markets/ (Paper account)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Trading loop
COOLDOWN_SECONDS=15

# Risk / trade sizing
# When adding to an existing position, cap how much you can add as a % of current position value
MAX_EXISTING_POSITION_PCT_TO_ADD=0.10

# Simple TP/SL
TAKE_PROFIT_PCT=0.03
STOP_LOSS_PCT=0.02

# Backtest window (ISO-8601, UTC recommended)
# Example: 2025-12-01T00:00:00Z
BACKTEST_START=
BACKTEST_END=
BACKTEST_TIMEFRAME=1Hour

# News
# Use real news API calls (True) or stubs (False)
USE_REAL_NEWS=false
NEWS_CACHE_TTL_SECONDS=300
NEWS_LOOKBACK_DAYS=7
NEWS_LIMIT=10

# NewsAgent thresholds
NEWS_STRONG_THRESHOLD=0.60
NEWS_MIN_CONF_FOR_SIGNAL=0.60
